REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true
AI_PROVIDER=local
AI_API_KEY=
EXTERNAL_MODEL_DATA_PROCESSING_ENABLED=false
EMBEDDING_API_URL=
EMBEDDING_MODEL=multilingual-embedding-model
RERANKER_API_URL=
RERANKER_MODEL=cross-encoder-reranker
AI_REQUEST_TIMEOUT_SECONDS=8
MAX_RESUME_BYTES=5242880
MAX_RESUME_PAGES=30
MAX_RESUME_CHARACTERS=100000
RAPIDAPI_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
