APP_NAME=QuickHire EvidenceGraph API
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=quickhire-evidencegraph
JWT_AUDIENCE=quickhire-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=quickhire_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict
GOOGLE_CLIENT_ID=
