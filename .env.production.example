APP_NAME=QuickHire API
APP_ENV=production
SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
JWT_ISSUER=quickhire-production
JWT_AUDIENCE=quickhire-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=quickhire_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
REQUIRE_GOOGLE_AUTH=true
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://quickhire:replace-with-a-strong-database-password@postgres:5432/quickhire
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
APP_DOMAIN=jobs.example.com
API_DOMAIN=api.jobs.example.com
FRONTEND_ORIGINS=https://jobs.example.com
ALLOWED_HOSTS=api.jobs.example.com
PUBLIC_FRONTEND_URL=https://jobs.example.com
AUTO_CREATE_TABLES=false
AUTH_RATE_LIMIT_PER_MINUTE=12
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
EMAIL_DELIVERY_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM="QuickHire <notifications@example.com>"
RESEND_API_KEY=replace-with-provider-key
NOTIFICATION_POLL_SECONDS=2
NOTIFICATION_MAX_ATTEMPTS=5
AI_PROVIDER=local
AI_API_KEY=
EXTERNAL_MODEL_DATA_PROCESSING_ENABLED=false
EMBEDDING_API_URL=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_API_URL=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_API_URL=
LLM_MODEL=gpt-4.1-mini
TRANSCRIPTION_API_URL=
TRANSCRIPTION_MODEL=whisper-1
WHISPER_LOCAL_MODEL=small
VOICE_TRANSCRIPTION_ENABLED=false
MAX_INTERVIEW_AUDIO_BYTES=10485760
AI_REQUEST_TIMEOUT_SECONDS=8
MAX_RESUME_BYTES=5242880
MAX_RESUME_PAGES=30
MAX_RESUME_CHARACTERS=100000
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=15
REJECT_SCANNED_PDF_WITHOUT_TEXT=true
# Enable these only after fitting an artifact from a representative, labeled dataset.
CALIBRATION_MODEL_PATH=
REQUIRE_CALIBRATED_MODEL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ADMIN_NAME=Platform Administrator
